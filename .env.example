# marketdata settings (docs/PLAN.md §11). Copy to .env and fill in.
# Settings from later epics are listed so the file is complete; the app reads them from that epic on.
# Secrets come only from the environment or .env, never from code (PLAN.md §6).

# --- E0: all processes ---
# dev, live or prod. live and prod log JSON; dev logs readable lines.
ENV=dev
LOG_LEVEL=INFO
# A local PostgreSQL on 5432. The Docker Postgres from docker-compose.yml is on host port 5433.
DATABASE_URL=postgresql://marketdata:marketdata@localhost:5432/marketdata
# Tests only. A separate database whose name ends in _test: tests drop and recreate its schema.
TEST_DATABASE_URL=postgresql://marketdata:marketdata@localhost:5432/marketdata_test

# --- E1: SEC client and raw store ---
# local or s3. Raw files are write-once: the same key never gets different bytes.
RAW_STORE_KIND=local
RAW_STORE_PATH=./var/raw
# s3 only. Leave S3_ENDPOINT_URL empty for AWS; set it for R2 or B2. S3_REGION: B2 needs its
# region (e.g. us-west-004); R2 accepts auto.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "<app name> <contact email>", sent with every SEC request. Processes that call the SEC
# (worker, `marketdata sec ...`, scripts/fetch_fixture.py) refuse to start without it.
SEC_USER_AGENT=
# Requests per second across the process, spaced evenly; at most 8 (guardrail 6).
SEC_MAX_RPS=8

# --- E2: universe ---
# ticker,note: the companies we cover.
UNIVERSE_FILE=data/universe.csv
# ticker,security_type,source_url: types that a ticker's spelling gets wrong.
SECURITY_OVERRIDES_FILE=data/security_overrides.csv

# --- E3: task queue and filings watcher ---
# Tasks the worker runs at once (1-32). They share the process's one SEC rate limit.
WORKER_CONCURRENCY=4

# --- E7a: earnings extraction ---
# cik,predecessor_cik,source_url,note: earlier registrants holding a company's history (D-068).
PREDECESSORS_FILE=data/predecessors.csv
# Per-company pins for the earnings rules, in TOML (D-075).
EXTRACTION_OVERRIDES_FILE=data/extraction_overrides.toml

# --- E7c: live run alerts and error tracking ---
ALERT_EMAIL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
SENTRY_DSN=

# --- E5b: webhooks and proof links ---
# Fernet key that encrypts webhook signing secrets at rest.
WEBHOOK_ENCRYPTION_KEY=
PUBLIC_BASE_URL=

# --- E10: prices (vendor per OD-4) ---
PRICE_PROVIDER=
PRICE_API_KEY=

# --- E15: web UI ---
# private (HTTP Basic auth with an api-scope key) or public (OD-13)
UI_MODE=private

# --- E9: 13F fund portfolios ---
MANAGERS_FILE=data/managers.csv
OPENFIGI_API_KEY=

# --- E7b (on demand): Georgian localization ---
COMPANY_NAMES_KA_FILE=data/company_names_ka.csv
GLOSSARY_KA_FILE=data/glossary_ka.csv

# --- E12 and E13 only: LLM (OD-2). Not used in M1-M4 (D-014). ---
LLM_PROVIDER=
ANTHROPIC_API_KEY=
LLM_MODEL=
